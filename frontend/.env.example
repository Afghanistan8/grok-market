# All values are optional. The app ships safe fallbacks so a missing variable
# cannot brick a hosted deploy after the first build.

# Which GenLayer network to talk to: bradbury (default), studionet, or asimov.
# This sets the chain id, RPC, explorer and faucet together.
VITE_GENLAYER_NETWORK=studionet

# Deployed GrokMarket address. Without it the app runs read-only and says so.
VITE_GROKMARKET_CONTRACT_ADDRESS=0x1f774eb175CD0A1E82AB61422Fa231AD1bAC6742

# Optional RPC override. Leave unset to use the network preset.
# Never point this at the zkSync-OS ChainList host: it answers -32005 on writes.
# VITE_GENLAYER_RPC_URL=

# Optional. Injected wallets (MetaMask etc.) work without it.
VITE_WALLETCONNECT_PROJECT_ID=
