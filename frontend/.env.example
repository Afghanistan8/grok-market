# All three are optional. The app ships safe fallbacks so a missing variable
# cannot brick a hosted deploy after the first build.

# Deployed GrokMarket address. Without it the app runs in read-only demo mode
# and tells you what to set.
VITE_GROKMARKET_CONTRACT_ADDRESS=

# Defaults to https://rpc-bradbury.genlayer.com
# Do NOT point this at the zkSync-OS host: it rate limits writes with -32005.
VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Optional. Injected wallets (MetaMask etc.) work without it.
VITE_WALLETCONNECT_PROJECT_ID=
