# The app is locked to GenLayer studionet (chain 61999) and ships with the live
# contract address built in, so no variables are required to build or deploy.

# Only set this if the contract is redeployed to a new address.
# VITE_GROKMARKET_CONTRACT_ADDRESS=0x1f774eb175CD0A1E82AB61422Fa231AD1bAC6742

# Optional. Injected wallets (MetaMask etc.) work without it.
VITE_WALLETCONNECT_PROJECT_ID=
