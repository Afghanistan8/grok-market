{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/binance/:path*", "destination": "https://data-api.binance.vision/:path*" },
    { "source": "/stocks/:path*", "destination": "https://stockanalysis.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
